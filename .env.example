DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
DB_USER=vinheria_user
DB_PASSWORD=
DB_DRIVER=org.postgresql.Driver
DB_SCHEMA=public
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API C# (Catálogo) — lida pelo ASP.NET Core como ConnectionStrings:DefaultConnection.
# Nunca coloque a senha no appsettings.json (ver ConfiguracaoSegurancaTests).
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=<banco>;Username=<usuario>;Password=
