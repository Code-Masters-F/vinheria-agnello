         (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj); verificado na etapa Segurança do pipeline. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VinheriaApi\VinheriaApi.csproj" />
